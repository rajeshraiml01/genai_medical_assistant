from langchain_huggingface import HuggingFaceEmbeddings
from app.common.logger import get_logger
from app.common.custom_exception import CustomException
from app.config.config import HF_TOKEN
import os

logger = get_logger(__name__)


def get_embedding_model():
    try:
        logger.info("Loading HuggingFace embeddings model")
        
        # Check if we have internet connectivity and can download the model
        model_name = "sentence-transformers/all-MiniLM-L6-v2"
        
        # Configure model parameters
        model_kwargs = {'device': 'cpu'}  # Force CPU usage to avoid CUDA issues
        encode_kwargs = {'normalize_embeddings': True}
        
        # Create the embeddings model with authentication if available
        if HF_TOKEN:
            logger.info("Using HuggingFace authentication token")
            model = HuggingFaceEmbeddings(
                model_name=model_name,
                model_kwargs=model_kwargs,
                encode_kwargs=encode_kwargs,
                huggingfacehub_api_token=HF_TOKEN
            )
        else:
            logger.warning("No HuggingFace token found, attempting without authentication")
            model = HuggingFaceEmbeddings(
                model_name=model_name,
                model_kwargs=model_kwargs,
                encode_kwargs=encode_kwargs
            )
        
        logger.info("Successfully loaded HuggingFace embeddings model")
        return model
    except ImportError as e:
        error_message = CustomException("Missing required dependencies for embeddings. Please install: pip install sentence-transformers torch transformers", e)
        logger.error(str(error_message))
        raise error_message
    except Exception as e:
        error_message = CustomException("Failed to load embedding model", e)
        logger.error(str(error_message))
        raise error_message